-- Ventaja (Lectura más rápida): Acelera drásticamente la ejecución de consultas SELECT con filtros (WHERE), uniones (JOIN) y ordenamientos (ORDER BY), permitiendo a la base de datos encontrar registros mediante una búsqueda en árbol sin tener que leer la tabla completa (Full Table Scan).
-- el costo seria la escritura mas lenta , ya que cada que se agregan registros nuevos la base de datos tiene que restucturar y asociar los index nuevamente.
-- no conviene indexar todos porque Cuando existen demasiados índices, el optimizador de la base de datos gasta tiempo extra analizando cuál elegir antes de ejecutar la consulta, e incluso puede terminar seleccionando un índice no optimo.



-- EJERCICIO PRACTICO GUIADO PUNTO 9.
create index idx_nombre on cliente (nombre);  -- util para cuando se necesite filtrar a un cliente por nombre sin necesidasd de que se recorra toda la tabla.

SELECT cliente_id, nombre, fecha_registro FROM cliente where fecha_registro >= '2025-05-01';

create index idx_ciudad_fecha_registro on cliente (ciudad, fecha_registro); -- va primeron en el orden la ciudad porque es lo que nos interesa saber y despues la fecha para saber de esa ciudad hcae cuanto esta activo el cliente.

SELECT cliente_id, nombre, apellido FROM cliente WHERE ciudad = 'Pereira' AND activo = 1;

CREATE UNIQUE INDEX idx_cliente_correo ON cliente (correo); -- indica que solo puede haber un correo unico por cliente, asi es mas facil filtrar por correo y encontrar el registro exactro.

SELECT correo, COUNT(*) AS cantidad FROM cliente GROUP BY correo HAVING COUNT(*) > 1;

